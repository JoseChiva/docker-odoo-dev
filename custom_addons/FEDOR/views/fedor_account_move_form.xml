<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fedor_account_move_form" model="ir.ui.view">
            <field name="name">fedor_account_move_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='journal_div']" position="after">
                    <field name="currency_rate" invisible="currency_id==company_currency_id" readonly="state=='posted'" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>