<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="act_fedor_type" model="ir.actions.act_window">
            <field name="name">Tipo</field>
            <field name="res_model">fedor.type</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_fedor_type" model="ir.ui.view">
            <field name="name">Lista de Tipo</field>
            <field name="model">fedor.type</field>
            <field name="arch" type="xml">
                <tree >
                    <field name="name"/>
                    <field name="code" />
                </tree>
            </field>
        </record>
        <record id="frm_fedor_type" model="ir.ui.view">
            <field name="name">Familia de producto</field>
            <field name="model">fedor.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        
                        <group>
                            <group col="2">
                                <field name="code"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <menuitem id="menu_fedor_type_action"
        name="Tipo"
        action="act_fedor_type"
        parent="sale.product_menu_catalog"
        sequence="101" />
    </data>
</odoo>
