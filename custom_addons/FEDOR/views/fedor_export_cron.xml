<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fedor_export_cron" model="ir.cron">
            <field name="name">fedor_export_cron</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(datetime.utcnow()+timedelta(days=0)).strftime('%Y-%m-%d 22:00:00')"/>
            <field name="model_id" ref="model_fedor_export_cron"/>
            <field name="state">code</field>
            <field name="code">model.export_file()</field>
        </record>
    </data>
</odoo>