<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="act_fedor_log_export_import_line" model="ir.actions.act_window">
            <field name="name">Log importación/exportación</field>
            <field name="res_model">fedor.export.import.log.line</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_fedor_log_export_import_line" model="ir.ui.view">
            <field name="name">Lista de Log importación/exportación</field>
            <field name="model">fedor.export.import.log.line</field>
            <field name="arch" type="xml">
                <tree >
                    <field name="name"/>
                    <field name="attachment_id"/>
                    <button name="download_file" string="Descargar" type="object"
                                        class="btn btn-success text-uppercase" />
                </tree>
            </field>
        </record>
        <record id="frm_fedor_log_export_import_line" model="ir.ui.view">
            <field name="name">Log importación/exportación</field>
            <field name="model">fedor.export.import.log.line</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        
                        <group>
                            <group col="2">
                                <field name="attachment_id"/>
                                <header>
                                    <button name="download_file" string="Descargar" type="object"
                                        class="btn btn-success text-uppercase" />
                                </header>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
