<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="product_supplierinfo_tree">
        <field name="name">product_supplierinfo_tree</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="multi_discount"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="product_supplierinfo_form">
        <field name="name">product_supplierinfo_form</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='discount']" position="after">
                <field name="multi_discount"/>
            </xpath>
        </field>
    </record>

</odoo>
