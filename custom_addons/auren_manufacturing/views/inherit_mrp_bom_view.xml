<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="inherit_mrp_bom_action" model="ir.actions.act_window">
            <field name="name">auren.man.inherit.mrp.bom.action</field>
            <field name="res_model">mrp.bom</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_available_properties': True}</field>
        </record>
        <record id="inherit_mrp_bom_form" model="ir.ui.view">
            <field name="name">inherit.mrp.bom.form</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//page/field[@name='bom_line_ids']/tree/field[@name='product_qty']" position="before">
                    <field name="unit_ua" groups="auren_otools.group_dim_inv"/>
                    <field name="var1" groups="auren_otools.group_dim_var1"/>
                    <field name="var2" groups="auren_otools.group_dim_var2"/>
                    <field name="var3" groups="auren_otools.group_dim_var3"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>