<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="inherit_mrp_routing_workcenter_action" model="ir.actions.act_window">
            <field name="name">auren.man.inherit.mrp.routing.workcenter.action</field>
            <field name="res_model">mrp.routing.workcenter</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_available_properties': True}</field>
        </record>
        <record id="inherit_mrp_routing_workcenter_tree" model="ir.ui.view">
            <field name="name">auren.man.inherit.mrp.routing.workcenter.tree</field>
            <field name="model">mrp.routing.workcenter</field>
            <field name="inherit_id" ref="mrp.mrp_routing_workcenter_tree_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='time_mode']" position="after">
                    <field name="description"/>
                    <field name="x_numop"/>
                    <field name="x_minop"/>
                    <field name="time_start" sum="Total Setup time"/>
                    <field name="time_stop" sum="Total Cleanup time"/>
                </xpath>
            </field>
        </record>
        <record id="inherit_mrp_routing_workcenter_form" model="ir.ui.view">
            <field name="name">inherit.mrp.routing.workcenter.form</field>
            <field name="model">mrp.routing.workcenter</field>
            <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='time_mode']" position="after">
                    <field name="x_numop"/>
                    <field name="x_minop"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="before">
                    <field name="template_op"/>
                    <field name="description"/>
                    <field name="time_start" sum="Total Setup time"/>
                    <field name="time_stop" sum="Total Cleanup time"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>