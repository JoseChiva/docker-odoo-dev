<odoo>
    <record id="view_hello_world_form" model="ir.ui.view">
        <field name="name">hello.world.form</field>
        <field name="model">hello.world</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hello_world_list" model="ir.ui.view">
        <field name="name">hello.world.list</field>
        <field name="model">hello.world</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_hello_world" model="ir.actions.act_window">
        <field name="name">Hello World</field>
        <field name="res_model">hello.world</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hello_world_root" name="Hello World" sequence="10"/>
    <record id="menu_hello_world_action" model="ir.ui.menu">
        <field name="name">Hello World</field>
        <field name="parent_id" ref="menu_hello_world_root"/>
        <field name="action" ref="action_hello_world"/>
    </record>
</odoo>