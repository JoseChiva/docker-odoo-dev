<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="auren_otools_purchase_order" model="ir.ui.view">
            <field name="name">auren_otools_purchase_order</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <!-- find field description and add the field
                     new_field after it -->
                <xpath expr="//field[@name='order_line']/form//field[@name='product_qty']"
                    position="before">
                    <field name="unit" groups="auren_otools.group_dim_purchase" optional="show"/>
                    <field name="var1" groups="auren_otools.group_dim_var1_purchase" optional="show"/>
                    <field name="var2" groups="auren_otools.group_dim_var2_purchase" optional="show"/>
                    <field name="var3" groups="auren_otools.group_dim_var3_purchase" optional="show"/>
                    <field name="qty_inventory" string="Cantidad inventario" readonly="True" groups="auren_otools.group_extended_uom_purchase_qty" optional="show" force_save="1"/>
                    <field name="conversion_factor" string="Factor Uom" readonly="True" groups="auren_otools.group_extended_uom_purchase_con" optional="show" force_save="1"/>
                    <!-- <field name="unit__factor" string="Conversión dim" readonly="True" /> -->
                </xpath>

            </field>
        </record>
    </data>
</odoo>