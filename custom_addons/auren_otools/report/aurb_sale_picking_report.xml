<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_aurb_sale_picking_format_prin">
        <t t-name="studio_main_report">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-call="auren_otools.report_aurb_sale_picking_format_body" />
                    <p style="page-break-after: always;" />
                </t>
            </t>
        </t>
    </template>
    <template id="report_aurb_sale_picking_format_body">
        <t t-name="studio_main_report">
            <t t-if="not o" t-set="o" t-value="doc" />

            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id" />
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()" />
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company" />
                </t>
            </t>

            <!-- <t t-call="auren_otools.report_head" /> -->
            <div class="container o_text_columns">
                <tbody class="sale_tbody">
                    <div class="page">
                        <div class="oe_structure"> Nombre : <span t-field="doc.name" />
                            <br />Transportista : <span
                                t-field="doc.carrier_id" />
                            , Fecha : <span t-field="doc.date" />
                            <br />
                            <table
                                class="table table-sm o_main_table table-borderless mt-4">
                                <thead>
                                    <tr>
                                        <td>
                                            <p>
                                                <strong>
                                                    <span style="font-size: 0.75rem;">
                                                        <font style="vertical-align: inherit;">
                            Albaran </font>
                                                    </span>
                                                </strong>
                                            </p>
                                        </td>
                                        <!-- <td>
                                            <p>
                                                <strong>
                                                    <span style="font-size: 0.75rem;">
                                                        <font style="vertical-align: inherit;">
                            Cliente </font>
                                                    </span>
                                                </strong>
                                            </p>
                                        </td> -->
                                        <td>
                                            <p>
                                                <strong>
                                                    <span style="font-size: 0.75rem;">
                                                        <font style="vertical-align: inherit;">
                            Persona de contacto </font>
                                                    </span>
                                                </strong>
                                            </p>
                                        </td>
                                        <td>
                                            <p>
                                                <strong>
                                                    <span style="font-size: 0.75rem;">
                                                        <font style="vertical-align: inherit;">
                            Dirección </font>
                                                    </span>
                                                </strong>
                                            </p>
                                        </td>
                                        <td>
                                            <p>
                                                <strong>
                                                    <span style="font-size: 0.75rem;">
                                                        <font style="vertical-align: inherit;">
                            Producto </font>
                                                    </span>
                                                </strong>
                                            </p>
                                        </td>
                                        
                                        <td class="text-end">
                                            <p>
                                                <strong>
                                                    <span style="font-size: 0.75rem;">
                                                        <font style="vertical-align: inherit;">A entregar </font>
                                                    </span>
                                                </strong>
                                            </p>
                                        </td>
                                        <td class="text-end">
                                            <p>
                                                <strong>
                                                    <span style="font-size: 0.75rem;">
                                                        <font style="vertical-align: inherit;">
                            Comentario </font>
                                                    </span>
                                                </strong>
                                            </p>
                                        </td>
                                    </tr>
                                </thead>
                                <t t-set="partner" t-value=""/>
                                <t t-foreach="doc.sale_order_line_ids.sorted(key=lambda r: (r.res_partner_contact.id,r.pick_order))" t-as="line">
                                    
                                    <tbody style="border-top: 1px solid black;">
                                        <tr style="height: 19.2px;" t-if="line.pick_print">
                                            
                                            <td>
                                                <p>
                                                    <span t-field="line.order_id"
                                                        style="font-size: 0.75rem;" />
                                                </p>
                                            </td>
                                            <!-- <td>
                                                <p>
                                                    <span t-field="line.partner_id"
                                                        style="font-size: 0.75rem;" />
                                                </p>
                                            </td> -->
                                            <td>
                                                <t t-if="partner!=line.res_partner_contact.name">
                                                    <p>
                                                        <span t-field="line.res_partner_contact"
                                                            style="font-size: 0.75rem;" />
                                                    </p>
                                                </t>
                                                
                                            </td>
                                            <td>
                                                <p>
                                                    <!-- <div t-field="line.order_id.partner_id.name"/> -->
                                                    <!-- <div t-field="line.order_id.partner_id.contact_address_complete"/> -->
                                                    <!-- <div t-field="line.order_id.partner_id.phone"/> -->
                                                    <div t-field="line.order_id.partner_id"
                                                        t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;phone&quot;]}" style="font-size: 0.75rem;">
                                                    </div>
                                                </p>
                                            </td>
                                            <td>
                                                <p>
                                                    <span t-field="line.product_id"
                                                        style="font-size: 0.75rem;" />
                                                </p>
                                            </td>
                                            <td class="text-end">
                                                <p>
                                                    <span t-field="line.product_uom_qty"
                                                        t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"
                                                        style="font-size: 0.75rem;" />
                                                </p>
                                            </td>
                                            <td class="text-end">
                                                <p>
                                                    <span t-field="line.pick_comment"
                                                        style="font-size: 0.75rem;" />
                                                </p>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <t t-set="partner" t-value="line.res_partner_contact.name"/>
                                </t>

                            </table>

                        </div>
                    </div>
                </tbody>
            </div>
            <t t-call="auren_otools.report_footer" />
        </t>

    </template>

    <template id="report_head">
        <div t-attf-class="header o_company_#{company.id}_layout"
            t-att-style="report_header_style">
            <div class="container o_text_columns">
                <div class="row">
                    <div class="column" style="width: 50%;">
                        <div class="col-3 mb4">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                style="max-height: 45px;" alt="Logo" />
                        </div>
                        <div>
                            <span t-field="doc.company_id" style="font-size: 0.75rem;" />
                            <br />
                            <span t-field="doc.company_id.street" style="font-size: 0.75rem;">
                                <font style="vertical-align: inherit;">Detalles</font>
                            </span>
                            <br />
                            <span t-field="doc.company_id.zip" style="font-size: 0.75rem;">
                                <font style="vertical-align: inherit;">CP</font>
                            </span>
                            <span t-field="doc.company_id.city" style="font-size: 0.75rem;">
                                <font style="vertical-align: inherit;">Ciudad</font>
                            </span>
                            <br />
                            <span t-field="doc.company_id.website" style="font-size: 0.75rem;">
                                <font style="vertical-align: inherit;">web</font>
                            </span>
                            <br />
                        </div>
                        <div>
                            <span style="font-size: 0.75rem;">
                                <font style="vertical-align: inherit;">T.  </font>
                            </span>
                            <span t-field="doc.company_id.phone" style="font-size: 0.75rem;">
                                <font style="vertical-align: inherit;">Teléfono</font>
                            </span>
                            <span style="font-size: 0.75rem;">
                                <font style="vertical-align: inherit;">/ </font>
                            </span>
                            <span style="font-size: 0.75rem;">
                                <font style="vertical-align: inherit;">M.  </font>
                            </span>
                            <span t-field="doc.company_id.mobile" style="font-size: 0.75rem;">
                                <font style="vertical-align: inherit;">Móvil</font>
                            </span>
                        </div>
                    </div>

                </div>

            </div>
        </div>

    </template>

    <template id="report_footer">
        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
            <div class="row" style="font-size: 0.5rem">
                <!-- <span t-field="doc.company_id.commercial_registry">Registro Mercantil</span> -->
            </div>
            <div class="text-center" style="border-top: 1px solid black;">

                <ul class="list-inline mb4">
                    <div t-field="company.report_footer" />
                </ul>

                <div t-if="report_type == 'pdf'" class="text-muted"> Page: <span class="page" /> / <span
                        class="topage" />
                </div>
                <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">
                    <span t-out="o.name">(document name)</span>
                </div>
            </div>
        </div>
    </template>
</odoo>