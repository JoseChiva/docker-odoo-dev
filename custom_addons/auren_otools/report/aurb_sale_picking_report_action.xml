<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_sale_picking_report_action" model="ir.actions.report">
        <field name="name">report_sale_picking_report_action</field>
        <field name="model">aurb.sale.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">auren_otools.report_aurb_sale_picking_format_prin</field> <!-- Es el id del template con el prefijo del nombre del modulo-->
        <field name="report_file">auren_otools.report_aurb_sale_picking_format_prin</field>
        <field name="print_report_name">'Picking - %s' % (object.name).replace('/','')</field>
        <field name="binding_model_id" ref="auren_otools.model_aurb_sale_picking"/> <!-- Es el id del modelo con el prefijo 'model_'-->
    </record>
</odoo>