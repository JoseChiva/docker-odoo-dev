<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="act_product_uom_scandal" model="ir.actions.act_window">
            <field name="name">Product Uom scandal</field>
            <field name="res_model">auren.exuom.product.uom.scandal</field>
            <field name="view_mode">list</field>
        </record>
        <record id="lst_product_uom_scandal" model="ir.ui.view">
            <field name="name">Product Uom scandal</field>
            <field name="model">auren.exuom.product.uom.scandal</field>
            <field name="arch" type="xml">
                <list string="Product Uom scandal List" editable="bottom" >
                    <field name="product_id" />
                    <field name="uom_id"/>
                    <field name="conversion_factor"/>
                </list>
            </field>
        </record>
        <menuitem id="mn_product_uom_scandal"
        name="Uom Product scandal"
        action="act_product_uom_scandal"
        parent="stock.menu_stock_inventory_control"
        sequence="150" />
    </data>
</odoo>
