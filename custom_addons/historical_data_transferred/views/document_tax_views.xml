<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aurb_hdt_document_tax_view_tree" model="ir.ui.view">
        <field name="name">aurb.hdt.document.tax.view.tree</field>
        <field name="model">aurb.hdt.document.tax</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="name"/>
            </tree>
        </field>
    </record>
    
    <record id="aurb_hdt_document_tax_action" model="ir.actions.act_window">
        <field name="name">Document's tax</field>
        <field name="res_model">aurb.hdt.document.tax</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Invoice's tax
            </p>
            
        </field>
    </record>
</odoo>
