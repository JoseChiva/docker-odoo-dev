<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_transport_agency" model="ir.actions.act_window">
            <field name="name">Transport Agency</field>
            <field name="res_model">aurb.hdt.transport.agency</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_transport_agency" model="ir.ui.view">
            <field name="name">Transport Agency List</field>
            <field name="model">aurb.hdt.transport.agency</field>
            <field name="arch" type="xml">
                <tree string="Transport Agency List">
                    <field name="codigo" />
                    <field name="nombre" />
                    <field name="direccion" />
                    <field name="poblacion"/>
                    <field name="provincia"/>
                    <field name="pais"/>
                    <field name="cp"/>
                    <field name="telefono"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
