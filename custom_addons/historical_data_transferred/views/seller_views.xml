        <record id="act_hdt_seller" model="ir.actions.act_window">
            <field name="name">Seller</field>
            <field name="res_model">aurb.hdt.seller</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_seller" model="ir.ui.view">
            <field name="name">Seller List</field>
            <field name="model">aurb.hdt.seller</field>
            <field name="arch" type="xml">
                <tree string="Seller List">
                    <field name="empresa_id" />
                    <field name="subcta" />
                    <field name="linea_producto" />
                    <field name="clv_ven"/>
                    <field name="iva"/>
                    <field name="irpf"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
