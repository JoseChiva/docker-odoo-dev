<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_pos_payment_method" model="ir.actions.act_window">
            <field name="name">POS payment method</field>
            <field name="res_model">aurb.hdt.pos.payment.method</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_pos_payment_method" model="ir.ui.view">
            <field name="name">POS payment method List</field>
            <field name="model">aurb.hdt.pos.payment.method</field>
            <field name="arch" type="xml">
                <tree string="POS payment method List">
                    <field name="codigo_pago"/>
                    <field name="descripcion"/>
                    <field name="tipo" />
                </tree>
            </field>
        </record>
    </data>
</odoo>
