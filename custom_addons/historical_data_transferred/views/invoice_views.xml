<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="act_hdt_invoice_sales" model="ir.actions.act_window">
            <field name="name">Sales Invoice Filter</field>
            <field name="res_model">aurb.hdt.invoice</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_doc_fv': True}</field>
        </record>
        <record id="lst_hdt_invoice" model="ir.ui.view">
            <field name="name">aurb.hdt.invoice.tree</field>
            <field name="model">aurb.hdt.invoice</field>
            <field name="arch" type="xml">
                <tree string="Invoice List" >
                    <field name="empresa_id" />
                    <field name="ejercicio" />
                    <field name="documento" />
                    <field name="fecha_documento"/>
                    <field name="total_bruto"/>
                    <field name="total_neto_euros"/>
                </tree>
            </field>
        </record>
        <record id="frm_hdt_invoice" model="ir.ui.view">
            <field name="name">aur.hdt.invoice.form</field>
            <field name="model">aurb.hdt.invoice</field>
            <field name="arch" type="xml">
                <form string="Invoice Form">
                    <header>
                        <field name="status_doc" widget="statusbar" readonly="true" statusbar_visible="borrador,facturado,contabilizado"/>
                    </header>
                    <sheet>
                        <group name="invoice_header">
                            <group>
                                <field name="empresa_id" string="Empresa"/>
                                <field name="almacen_id" string="Almacén"/>
                                <field name="ejercicio" string="Ejercicio" />
                                <field name="moneda_id" string="Moneda"/>
                                <field name="nombre_ic" string="IC"/>
                                <field name="referencia" string="Referencia"/>
                                <field name="tarifa" string="Tarifa"/>
                                <field name="vendedor_1" string="Vendedor"/>
                                <field name="agencia_transporte" string="Agencia"/>
                            </group>
                            <group>
                                <field name="subcta" string="Cliente"/>
                                <field name="tipo_forma_pago" string="F.Pago"/>
                                <field name="fecha_documento" string="Fecha"/>
                                <field name="fecha_valor" string="Fecha valor"/>
                                <field name="tipo_iva" string="Tipo IVA"/>
                                <field name="categoria" string="Categoria"/>
                                <field name="documento" string="Factura"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="invoice_lines" string="Invoice lines">
                                <group>
                                    <field name="lines_ids">
                                        <tree>
                                            <field name="articulo" string="Artículo"/>
                                            <field name="articulo_des" string="Descripción"/>
                                            <field name="bultos" string="Bultos"/>
                                            <field name="cantidad" string="Peces"/>
                                            <field name="precio" string="Precio"/>
                                            <field name="descuento_1" string="Dto.1"/>
                                            <field name="descuento_2" string="Dto.2"/>
                                            <field name="descuento_3" string="Dto.3"/>
                                            <field name="total_linea" string="Importe"/>
                                        </tree>
                                    </field>
                                </group>
                                <group>
                                    <group>
                                        <field name="total_bruto" string="Total Bruto:"/>
                                    </group>
                                    <group>
                                        <field name="total_descuentos" string="Descuentos:"/>
                                    </group>
                                    <group>
                                        <field name="total_impuestos" string="Impuestos:"/>
                                    </group>
                                    <group>
                                        <field name="total_neto_euros" string="TOTAL NETO EUR"/>
                                    </group>
                                </group>
                            </page>
                        
                            
                            <page name="totales" string="Totales">
                                     <group>
                                          <field name="total_documento_ids">
                                                <tree>
                                                    <field name="ri_base1" string="Base imponible"/>
                                                    <field name="ri_tipo1" string="tipo"/>
                                                    <field name="ri_cuota1"     string="Cuota"/>
                                                    
                                                       
                                                    <field name="ri_base2" string="Base imponible" attrs="{'invisible': [('ri_base2', '=', 0)]}"/>
                                                    <field name="ri_tipo2" string="tipo" attrs="{'invisible': [('ri_tipo2', '=', 0)]}"/> 
                                                    <field name="ri_cuota2"     string="Cuota" attrs="{'invisible': [('ri_cuota2', '=', 0)]}"/>
                                                    

                                                    <field name="ri_base3" string="Base imponible" attrs="{'invisible': [('ri_base3', '=', 0)]}"/>
                                                    <field name="ri_tipo3" string="tipo" attrs="{'invisible': [('ri_tipo3', '=', 0)]}"/> 
                                                    <field name="ri_cuota3" string="Cuota" attrs="{'invisible': [('ri_cuota3', '=', 0)]}"/>
                                                   

                                                    <field name="b_total_doc" string="Total documento"/> 

                                                   

                                                </tree>
                                                
                                            </field>
                                         </group>
                                     
                            </page>

                            <page name="vencimientos" string="vencimientos">
                                <group>
                                    <field name="cobrospdf_ids">
                                        <tree>
                                                <field name="fechavto" string="Fecha vto"/>
                                                
                                                
                                        </tree>
                                        
                                    </field>
                                </group>
         
                            </page>




                            
                            
                            
                            
                            
                            
                                                                                    
                            <page name="invoice_address" string="Addresses">
                                   <group>
                                        
                                        
                                                    <field name="d_orden" string="Orden"/>
                                                    <field name="d_idioma" string="Idioma"/>
                                                    <field name="d_tipus" string="Tipo"/>
                                                    <field name="d_nombre_comercial" string="Nombre comercial"/>
                                                    <field name="d_nombre_comercial2" string="Nombre comercial 2"/>
                                                    <field name="d_direccion" string="Dirección"/>
                                                    <field name="d_direccion2" string="Dirección 2"/>
                                                    <field name="d_codigo_postal" string="CP"/>
                                                    <field name="d_poblacion" string="Población"/>
                                                    <field name="d_provincia" string="Provincia"/>
                                                    <field name="d_dni_nif" string="DNI/NIF"/>
                                                    <field name="d_telefonos" string="Teléfono"/>
                                                    <field name="d_contacte" string="Persona contacto"/>
                                        
                                        
                                   </group>
                                    
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="src_hdt_invoice" model="ir.ui.view">
            <field name="name">Invoice Search</field>
            <field name="model">aurb.hdt.invoice</field>
            <field name="arch" type="xml">
                <search string="Invoice Search">
                    <field name="name"/>
                    <field name="tipo_doc"/>
                    <filter string="Factura venta" name="tipo_doc_fv" domain="[('tipo_doc', '=', 'FV')]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
