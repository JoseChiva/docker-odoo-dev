<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="act_hdt_stock_transfer_lines" model="ir.actions.act_window">
            <field name="name">Stock Transfer Lines Filter</field>
            <field name="res_model">aurb.hdt.stock.transfer.lines</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_stock_transfer_lines" model="ir.ui.view">
            <field name="name">Stock Transfer Lines List</field>
            <field name="model">aurb.hdt.stock.transfer.lines</field>
            <field name="arch" type="xml">
                <tree string="Stock transfer Lines List">
                    <field name="empresa_id" />
                    <field name="ejercicio_id"/>
                    <field name="tipo_movimiento"/>
                    <field name="documento_id"/>
                </tree>
            </field>
        </record>
        <record id="src_hdt_stock_transfer_lines" model="ir.ui.view">
            <field name="name">Stock Transfer Lines Search</field>
            <field name="model">aurb.hdt.stock.transfer.lines</field>
            <field name="arch" type="xml">
                <search string="Stock Transfer Lines Search">
                    <field name="name"/>
                    <field name="tipo_movimiento"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
