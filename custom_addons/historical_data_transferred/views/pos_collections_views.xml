<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_pos_collections" model="ir.actions.act_window">
            <field name="name">POS collections</field>
            <field name="res_model">aurb.hdt.pos.collections</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_pos_collections" model="ir.ui.view">
            <field name="name">POS collections List</field>
            <field name="model">aurb.hdt.pos.collections</field>
            <field name="arch" type="xml">
                <tree string="POS collections List">
                    <field name="empresa_id"/>
                    <field name="ejercicio_id"/>
                    <field name="almacen_id"/>
                    <field name="tipo_doc"/>
                    <field name="documento" />
                    <field name="fecha" />
                    <field name="importe" />
                    <field name="moneda_id" />
                    <field name="tpv_id"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
