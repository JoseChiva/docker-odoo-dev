<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_pos_cash_count" model="ir.actions.act_window">
            <field name="name">POS Cash count</field>
            <field name="res_model">aurb.hdt.pos.cash.count</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_pos_cash_count" model="ir.ui.view">
            <field name="name">POS Cash count List</field>
            <field name="model">aurb.hdt.pos.cash.count</field>
            <field name="arch" type="xml">
                <tree string="POS Cash count List">
                    <field name="empresa_id"/>
                    <field name="tpv_id"/>
                    <field name="fecha" />
                    <field name="ar1" />
                    <field name="ar2" />
                </tree>
            </field>
        </record>
    </data>
</odoo>
