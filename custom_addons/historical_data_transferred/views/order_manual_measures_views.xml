<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_order_sales_manual_measures" model="ir.actions.act_window">
            <field name="name">Pedido venta manual measures</field>
            <field name="res_model">aurb.hdt.order.manual.measures</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_movimiento_pv': True}</field>
        </record>
        <record id="act_hdt_order_purchase_manual_measures" model="ir.actions.act_window">
            <field name="name">Pedido compra manual measures</field>
            <field name="res_model">aurb.hdt.order.manual.measures</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_movimiento_pc': True}</field>
        </record>
        <record id="act_hdt_order_budget_manual_measures" model="ir.actions.act_window">
            <field name="name">Presupuesto líneas manual measures</field>
            <field name="res_model">aurb.hdt.order.manual.measures</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_movimiento_pp': True}</field>
        </record>
        <record id="lst_hdt_manual_measures" model="ir.ui.view">
            <field name="name">Order manual desc</field>
            <field name="model">aurb.hdt.order.manual.measures</field>
            <field name="arch" type="xml">
                <tree string="Pedido de venta lines List">
                    <field name="empresa_id" />
                    <field name="ejercicio"/>
                    <field name="documento_id"/>
                    <field name="cantidad"/>
                    <field name="largo"/>
                    <field name="ancho"/>
                    <field name="grueso"/>
                </tree>
            </field>
        </record>
        <record id="src_hdt_manual_measures" model="ir.ui.view">
            <field name="name">Order manual desc Search</field>
            <field name="model">aurb.hdt.order.manual.measures</field>
            <field name="arch" type="xml">
                <search string="manual measures Search">
                    <field name="name"/>
                    <field name="tipo_movimiento"/>
                    <filter string="Pedido venta" name="tipo_movimiento_pv" domain="[('tipo_movimiento', '=', 'PV')]"/>
                    <filter string="Pedido compra" name="tipo_movimiento_pc" domain="[('tipo_movimiento', '=', 'PC')]"/>
                    <filter string="Presupuesto" name="tipo_movimiento_pp" domain="[('tipo_movimiento', '=', 'PP')]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
