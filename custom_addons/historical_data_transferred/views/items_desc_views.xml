            <field name="name">items desc List</field>
            <field name="model">aurb.hdt.items.desc</field>
            <field name="arch" type="xml">
                <tree string="items List">
                    <field name="empresa_id" />
                    <field name="codigo_id" />
                    <field name="clv_art" />
                    <field name="subcta"/>
                    <field name="idioma"/>
                    <field name="descripcion"/>
