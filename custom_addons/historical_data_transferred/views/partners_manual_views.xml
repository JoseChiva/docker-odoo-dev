<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_partners_manual" model="ir.actions.act_window">
            <field name="name">Partners Manual</field>
            <field name="res_model">aurb.hdt.partners.manual</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_partners_manual" model="ir.ui.view">
            <field name="name">Partners Manual List</field>
            <field name="model">aurb.hdt.partners.manual</field>
            <field name="arch" type="xml">
                <tree string="Partners Manual List">
                    <field name="empresa_id" />
                    <field name="ejercicio" />
                    <field name="almacen_id" />
                    <field name="documento"/>
                    <field name="subcta_id"/>
                    <field name="titulo"/>
                    <field name="dni_nif"/>
                    <field name="direccion"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
