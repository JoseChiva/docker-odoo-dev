<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_languages" model="ir.actions.act_window">
            <field name="name">Languages</field>
            <field name="res_model">aurb.hdt.languages</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_laguages" model="ir.ui.view">
            <field name="name">Languages List</field>
            <field name="model">aurb.hdt.languages</field>
            <field name="arch" type="xml">
                <tree string="Languages List">
                    <field name="idioma" />
                    <field name="nombre" />
                </tree>
            </field>
        </record>
    </data>
</odoo>
