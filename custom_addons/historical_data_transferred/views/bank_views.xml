<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_bank" model="ir.actions.act_window">
            <field name="name">Bank</field>
            <field name="res_model">aurb.hdt.bank</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_bank" model="ir.ui.view">
            <field name="name">Bank List</field>
            <field name="model">aurb.hdt.bank</field>
            <field name="arch" type="xml">
                <tree string="Bank List">
                    <field name="empresa_id"/>
                    <field name="nif"/>
                    <field name="direccion"/>
                    <field name="poblacion" />
                    <field name="pais"/>
                    <field name="provincia"/>
                    <field name="codigo_postal"/>
                    <field name="telefonos"/>
                    <field name="numero_cta"/>
                    <field name="observaciones"/>
                </tree>
            </field>
        </record>
        <record id="frm_hdt_bank" model="ir.ui.view">
            <field name="name">aur.hdt.bank.form</field>
            <field name="model">aurb.hdt.bank</field>
            <field name="arch" type="xml">
                <form string="Bank Form">
                    <sheet>
                        <group>
                            <field name="subcta" />
                            <field name="nif" />
                            <field name="direccion" />
                            <field name="poblacion" />
                            <field name="pais" />
                            <field name="provincia" />
                            <field name="codigo_postal" />
                            <field name="telefonos" />
                            <field name="numero_cta" />
                            <field name="limite_riesgo" />
                            <field name="observaciones" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
