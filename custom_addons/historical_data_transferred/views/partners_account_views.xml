            <field name="name">Partners Account List</field>
            <field name="model">aurb.hdt.partners.account</field>
            <field name="arch" type="xml">
                <tree string="Partners Account List">
                    <field name="empresa_id" />
                    <field name="subcta_id" />
                    <field name="linea_producto" />
                    <field name="tarifa"/>
                    <field name="portes"/>
                    <field name="agencia_transporte"/>
