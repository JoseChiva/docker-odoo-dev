<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_pos_assignment" model="ir.actions.act_window">
            <field name="name">POS assignment</field>
            <field name="res_model">aurb.hdt.pos.assignment</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_pos_assignment" model="ir.ui.view">
            <field name="name">POS assignment List</field>
            <field name="model">aurb.hdt.pos.assignment</field>
            <field name="arch" type="xml">
                <tree string="POS assignment List">
                    <field name="usuario"/>
                    <field name="empresa_id"/>
                    <field name="tpv" />
                </tree>
            </field>
        </record>
    </data>
</odoo>
