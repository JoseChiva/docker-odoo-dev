<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_outcoming_payments_effect" model="ir.actions.act_window">
            <field name="name">outcoming Payments effect</field>
            <field name="res_model">aurb.hdt.outcoming.payments.effect</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_outcoming_payments_effect" model="ir.ui.view">
            <field name="name">outcoming Payments effect List</field>
            <field name="model">aurb.hdt.outcoming.payments.effect</field>
            <field name="arch" type="xml">
                <tree string="outcoming Payments List">
                    <field name="name" />
                    <field name="empresa_id"/>
                    <field name="ejercicio_id" />
                    <field name="subcta"/>
                    <field name="documento"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
