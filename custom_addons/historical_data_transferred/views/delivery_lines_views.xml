<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_delivery_lines_sales" model="ir.actions.act_window">
            <field name="name">Albaran líneas venta</field>
            <field name="res_model">aurb.hdt.delivery.lines</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_movimiento_pv': True}</field>
        </record>
        <record id="act_hdt_delivery_purchase_lines" model="ir.actions.act_window">
            <field name="name">Albaran líneas compra</field>
            <field name="res_model">aurb.hdt.delivery.lines</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_movimiento_pc': True}</field>
        </record>
        <record id="lst_hdt_delivery_lines" model="ir.ui.view">
            <field name="name">Pedido de venta lines List</field>
            <field name="model">aurb.hdt.delivery.lines</field>
            <field name="arch" type="xml">
                <tree string="Albaran de venta lines List">
                    <field name="articulo" string="Artículo"/>
                    <field name="bultos_s" string="Bultos"/>
                    <field name="cantidad_s" string="Piezas"/>
                    <field name="precio" string="Precio"/>
                    <field name="descuento_1" string="Dto.1"/>
                    <field name="descuento_2" string="Dto.2"/>
                    <field name="descuento_3" string="Dto.3"/>
                    <field name="total_linea" string="Importe"/>
                </tree>
            </field>
        </record>
        <record id="src_hdt_delivery_lines" model="ir.ui.view">
            <field name="name">Albaran líneas Search</field>
            <field name="model">aurb.hdt.delivery.lines</field>
            <field name="arch" type="xml">
                <search string="Pedido líneas Search">
                    <field name="name"/>
                    <field name="tipo_movimiento"/>
                    <filter string="Albaran venta líneas" name="tipo_movimiento_pv" domain="[('tipo_movimiento', '=', 'SV')]"/>
                    <filter string="Albaran compra líneas" name="tipo_movimiento_pc" domain="[('tipo_movimiento', '=', 'EC')]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
