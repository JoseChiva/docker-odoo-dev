<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_subaccounts" model="ir.actions.act_window">
            <field name="name">Subaccounts</field>
            <field name="res_model">aurb.hdt.subaccounts</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_subaccounts" model="ir.ui.view">
            <field name="name">Subaccounts List</field>
            <field name="model">aurb.hdt.subaccounts</field>
            <field name="arch" type="xml">
                <tree string="Subaccounts List">
                    <field name="empresa_id" />
                    <field name="subcta" />
                    <field name="titulo" />
                    <field name="manual"/>
                    <field name="ficha_cerrada"/>
                    <field name="pedir_centro"/>
                    <field name="obligatorio"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
