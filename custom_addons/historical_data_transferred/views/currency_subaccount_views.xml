<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_currency_subaccount" model="ir.actions.act_window">
            <field name="name">Currency Subaccount</field>
            <field name="res_model">aurb.hdt.currency.subaccount</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_currency_subaccount" model="ir.ui.view">
            <field name="name">Currency Subaccount List</field>
            <field name="model">aurb.hdt.currency.subaccount</field>
            <field name="arch" type="xml">
                <tree string="Currency List">
                    <field name="moneda_ref" />
                    <field name="moneda_id" />
                    <field name="base" />
                    <field name="subcta_comp"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
