<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_delivery_zone" model="ir.actions.act_window">
            <field name="name">Delivery Zone</field>
            <field name="res_model">aurb.hdt.delivery.zone</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_delivery_zone" model="ir.ui.view">
            <field name="name">Delivery Zone List</field>
            <field name="model">aurb.hdt.delivery.zone</field>
            <field name="arch" type="xml">
                <tree string="Delivery Zone List">
                    <field name="empresa_id" />
                    <field name="zona_entrega" />
                    <field name="descripcion" />
                </tree>
            </field>
        </record>
    </data>
</odoo>
