<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_items" model="ir.actions.act_window">
            <field name="name">items</field>
            <field name="res_model">aurb.hdt.items</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_available_properties': True}</field>
        </record>
        <record id="lst_hdt_items" model="ir.ui.view">
            <field name="name">aurb.hdt.items.tree</field>
            <field name="model">aurb.hdt.items</field>
            <field name="arch" type="xml">
                <tree string="Items List" >
                    <field name="empresa_id" />
                    <field name="codigo" />
                    <field name="codigo_a" />
                    <field name="tipo"/>
                    <field name="tipo_art"/>
                </tree>
            </field>
        </record>
        <record id="frm_hdt_items" model="ir.ui.view">
            <field name="name">aur.hdt.items.form</field>
            <field name="model">aurb.hdt.items</field>
            <field name="arch" type="xml">
                <form string="Items Form">
                    <sheet>
                        <notebook>
                            <page name="articulos" string="Artículo">
                                <group>
                                    <field name="codigo" string="Código"/>
                                    <field name="name" string="Descripción"/>
                                    <field name="codigo_a" string="Codigo estadístico" />
                                    <field name="ficha_cerrada" string="Estado"/>
                                    <field name="fecha_baja" string="Fecha baja"/>
                                    <field name="tipo" string="Nivel"/>
                                </group>
                            </page>
                            <page name="descripciones" string="Descripciones">
                                <field name="items_desc_ids">
                                    <tree>
                                        <field name="descripcion" />
                                        <field name="subcta" string = "IC"/>
                                        <field name="idioma" string = "Idioma" />
                                    </tree>
                                </field>
                                   
                                   
                                   
                                   
                                   
                                   
                                
                            </page>
                            <page name="precios" string="Precios">
                                <field name="items_price_ids">
                                    <tree>
                                        <field name="moneda_id" string="Moneda Base"/>
                                        <field name="precio_std_1" string="Standard Uno"/>
                                        <field name="precio_std_2" string="Standard Dos"/>
                                        <field name="precio_std_3" string="Standard Tres"/>
                                        <field name="precio_std_4" string="Standard Cuatro"/>
                                        <field name="precio_u_entrada" string="Última Entrada"/>
                                        <field name="moneda_id" string="Moneda"/>
                                        <field name="cambio" string="Cambio"/>
                                        <field name="moneda_id" string="Moneda Base"/>
                                    </tree>                                 
                                </field>
                            </page>
                            <page name="claves" string="Claves">
                                <field name="items_keys_ids">
                                    <tree>
                                        <field name="clave" string="Clave"/>
                                        <field name="descripcion" string="Descripción"/>
                                        <field name="valor" string="Valor"/>
                                        <field name="tipo" string="Tipo"/>
                                    </tree>
                                </field>
                            </page>
                            <!-- <page name="ubicaciones" string="Ubicaciones">
                                <field name="items_batch_ids">
                                    <tree>
                                        <field name="almacen_id" string="Almacén"/>
                                        <field name="ubicacion" string="Ubicación"/>
                                        <field name="fecha_cad" string="Fecha Caducidad"/>
                                    </tree>
                                </field>
                            </page> -->
                            <!-- <page name="stocks" string="Stocks">
                                <field name="items_batch_ids">
                                    <tree>
                                        <field name="almacen_id" string="Almacén"/>
                                        <field name="stock_actual" string="Stock unitats"/>
                                    </tree>
                                </field>
                            </page> -->
                            <page name="lote" string="Lote">
                                <field name="items_batch_ids">
                                    <tree>
                                        <field name="lote_interno" string="Lote interno"/>
                                        <field name="lote_compra" string="Lote compra"/>
                                        <field name="almacen_id" string="Almacén"/>
                                        <field name="ubicacion" string="Ubicación"/>
                                        <field name="stock_actual" string="Stk actual"/>
                                        <field name="stock_bultos" string="Stk bultos"/>
                                        <field name="stock_reserva" string="Stk reserva"/>
                                        <field name="fecha_cad" string="Fecha cad."/>
                                        <field name="estado" string="Estado"/>
                                        <field name="fecha_alta" string="Fecha alta"/>
                                        <field name="fecha_bloq" string="Fecha bloq."/>
                                        <field name="motivo" string="Motivo"/>
                                        <field name="observacion" string="Observación"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="lotespieza" string="Pieza lote">
                                <field name="items_batch_piece_ids">
                                    <tree>
                                        <field name="almacen_id" string="Almacén"/>
                                        <field name="npieza" string="Npieza"/>
                                        <field name="lote_interno_id" string="Lote interno"/>
                                        <field name="ubicacion" string="Ubicación"/>
                                        <field name="calidad" string="Calidad"/>
                                        <field name="anchura" string="Anchura"/>
                                        <field name="cantidad" string="Cantidad"/>
                                        <field name="cantidad_s" string="Cantidad s."/>
                                        <field name="tara_desc" string="Tara desc"/>
                                        <field name="tara_m" string="Tara m"/>
                                        <field name="fecha_fabrica" string="Fecha fabricación"/>
                                        <field name="hora_fabrica" string="Hora fabricación"/>
                                        <field name="repasador" string="Repasador"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="incidencialote" string="Incidencia lote">
                                <field name="items_batch_incident_ids">
                                    <tree>
                                        <field name="almacen_id" string="Almacén"/>
                                        <field name="lote_interno_id" string="Lote interno"/>
                                        <field name="lote_compra" string="Lote compra"/>
                                        <field name="incidencia" string="Incidencia"/>
                                        <field name="fecha_entrada" string="Fecha entrada"/>
                                        <field name="hora_entrada" string="Hora entrada"/>
                                        <field name="usuario_entrada" string="Usuario entrada"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
