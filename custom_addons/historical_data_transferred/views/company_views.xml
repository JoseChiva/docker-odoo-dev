<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_company" model="ir.actions.act_window">
            <field name="name">Empresas</field>
            <field name="res_model">aurb.hdt.company</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_company" model="ir.ui.view">
            <field name="name">Empresas List</field>
            <field name="model">aurb.hdt.company</field>
            <field name="arch" type="xml">
                <tree string="Empresas List">
                    <field name="titulo"/>
                    <field name="direccion"/>
                    <field name="poblacion" />
                    <field name="provincia"/>
                    <field name="pais"/>
                    <field name="cp"/>
                    <field name="telefono"/>
                    <field name="nif"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
