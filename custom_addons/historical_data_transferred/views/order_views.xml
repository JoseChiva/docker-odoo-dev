<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="act_hdt_order_sales" model="ir.actions.act_window">
            <field name="name">Sales Order Filter</field>
            <field name="res_model">aurb.hdt.order</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_doc_pv': True}</field>
        </record>
        <record id="act_hdt_order_purchase" model="ir.actions.act_window">
            <field name="name">Purchase Order Filter</field>
            <field name="res_model">aurb.hdt.order</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_doc_pc': True}</field>
        </record>
        <record id="act_hdt_order_budget" model="ir.actions.act_window">
            <field name="name">Budget Order Filter</field>
            <field name="res_model">aurb.hdt.order</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_doc_pp': True}</field>
        </record>
        <record id="lst_hdt_order" model="ir.ui.view">
            <field name="name">Pedido List</field>
            <field name="model">aurb.hdt.order</field>
            <field name="arch" type="xml">
                <tree string="Pedido List">
                    <field name="empresa_id" />
                    <field name="ejercicio"/>
                    <field name="almacen_id"/>
                    <field name="subcta"/>
                    <field name="documento" />
                </tree>
            </field>
        </record>
        <record id="src_hdt_order" model="ir.ui.view">
            <field name="name">Pedido Search</field>
            <field name="model">aurb.hdt.order</field>
            <field name="arch" type="xml">
                <search string="Pedido Search">
                    <field name="name"/>
                    <field name="tipo_doc"/>
                    <filter string="Pedido venta" name="tipo_doc_pv" domain="[('tipo_doc', '=', 'PV')]"/>
                    <filter string="Pedido compra" name="tipo_doc_pc" domain="[('tipo_doc', '=', 'PC')]"/>
                    <filter string="Presupuesto" name="tipo_doc_pp" domain="[('tipo_doc', '=', 'PP')]"/>
                </search>
            </field>
        </record>
        <record id="frm_hdt_order" model="ir.ui.view">
            <field name="name">aur.hdt.order.form</field>
            <field name="model">aurb.hdt.order</field>
            <field name="arch" type="xml">
                <form string="Order Form">
                    <header>
                        <field name="status_doc" widget="statusbar" readonly="true" statusbar_visible="borrador,enviado,entregado"/>
                    </header>
                    <sheet>
                        <group name="order_header">
                            <group>
                                <field name="empresa_id" string="Empresa"/>
                                <field name="linea_producto" string="Línea prod"/>
                                <field name="almacen_id" string="Almacén"/>
                                <field name="ejercicio" string="Ejercicio" />
                                <field name="moneda_id" string="Moneda"/>
                                <field name="referencia" string="Referencia"/>
                                <field name="tarifa" string="Tarifa"/>
                                <field name="vendedor_1" string="Vendedor"/>
                                <field name="agencia_transporte" string="Agencia"/>
                            </group>
                            <group>
                                <field name="subcta" string="Cliente"/>
                                <field name="tipo_forma_pago" string="F.Pago"/>
                                <field name="fecha_documento" string="Fecha"/>
                                <field name="fecha_valor" string="Fecha valor"/>
                                <field name="tipo_iva" string="Tipo IVA"/>
                                <field name="documento" string="Pedido"/>
                                <field name="categoria" string="Categoria"/>
                                <field name="albaran_factura" string="Albarán"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="order_lines" string="Order lines">
                                <group>
                                    <field name="lines_ids">
                                        <tree>
                                            <field name="articulo" string="Artículo"/>
                                            <field name="articulo_des" string="Descripción"/>
                                            <field name="bultos" string="Bultos"/>
                                            <field name="cantidad" string="Peces"/>
                                            <field name="precio" string="Precio"/>
                                            <field name="descuento_1" string="Dto.1"/>
                                            <field name="descuento_2" string="Dto.2"/>
                                            <field name="descuento_3" string="Dto.3"/>
                                            <field name="total_linea" string="Importe"/>
                                        </tree>
                                    </field>
                                </group>
                                <group>
                                    <group>
                                        <field name="total_bruto" string="Total Bruto:"/>
                                    </group>
                                    <group>
                                        <field name="total_descuentos" string="Descuentos:"/>
                                    </group>
                                    <group>
                                        <field name="total_impuestos" string="Impuestos:"/>
                                    </group>
                                    <group>
                                        <field name="total_neto_euros" string="TOTAL NETO EUR"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
