<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_document_sales_notes" model="ir.actions.act_window">
            <field name="name">Pedido venta Observaciones</field>
            <field name="res_model">aurb.hdt.document.notes</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_doc_pv': True}</field>
        </record>
        <record id="act_hdt_document_purchase_notes" model="ir.actions.act_window">
            <field name="name">Pedido compra Observaciones</field>
            <field name="res_model">aurb.hdt.document.notes</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_doc_pc': True}</field>
        </record>
        <record id="act_hdt_document_budget_notes" model="ir.actions.act_window">
            <field name="name">Presupuesto líneas Observaciones</field>
            <field name="res_model">aurb.hdt.document.notes</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_tipo_doc_pp': True}</field>
        </record>
        <record id="lst_hdt_notes" model="ir.ui.view">
            <field name="name">document Observaciones</field>
            <field name="model">aurb.hdt.document.notes</field>
            <field name="arch" type="xml">
                <tree string="Pedido de venta lines List">
                    <field name="empresa_id" />
                    <field name="ejercicio"/>
                    <field name="documento_id"/>
                    <field name="descripcion" />
                </tree>
            </field>
        </record>
        <record id="src_hdt_notes_search" model="ir.ui.view">
            <field name="name">document manual desc Search</field>
            <field name="model">aurb.hdt.document.notes</field>
            <field name="arch" type="xml">
                <search string="Observaciones Search">
                    <field name="name"/>
                    <field name="tipo_doc"/>
                    <filter string="Pedido venta" name="tipo_doc_pv" domain="[('tipo_doc', '=', 'PV')]"/>
                    <filter string="Pedido compra" name="tipo_doc_pc" domain="[('tipo_doc', '=', 'PC')]"/>
                    <filter string="Presupuesto" name="tipo_doc_pp" domain="[('tipo_doc', '=', 'PP')]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
