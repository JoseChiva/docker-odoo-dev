<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>    
        <record id="act_hdt_document" model="ir.actions.act_window">
            <field name="name">Document</field>
            <field name="res_model">aurb.hdt.document</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lst_hdt_document" model="ir.ui.view">
            <field name="name">Document List</field>
            <field name="model">aurb.hdt.document</field>
            <field name="arch" type="xml">
                <tree string="Document List">
                    <field name="name" />
                    <field name="empresa_id"/>
                    <field name="almacen_id"/>
                    <field name="ejercicio" />
                    <field name="subcta"/>
                    <field name="ic_id"/>
                    <field name="documento"/>
                    <field name="tipo_doc"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
