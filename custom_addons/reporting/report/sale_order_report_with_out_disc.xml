                                    <td class="text-end" t-if="doc.valorado == True and disc1">
                                        <strong>
                                            <span t-if="doc.partner_id.lang == 'ca_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC 1% </font>
                                            </span>
                                            <span t-elif="doc.partner_id.lang == 'en_GB'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DISC 1% </font>
                                            </span>
                                            <span t-else="doc.partner_id.lang == 'es_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC 1% </font>
                                            </span>
                                        </strong>
                                    </td>
                                    <td class="text-end" t-if="doc.valorado == True and disc2">
                                        <strong>
                                            <span t-if="doc.partner_id.lang == 'ca_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC 2% </font>
                                            </span>
                                            <span t-elif="doc.partner_id.lang == 'en_GB'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DISC 2% </font>
                                            </span>
                                            <span t-else="doc.partner_id.lang == 'es_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC 2% </font>
                                            </span>
                                        </strong>
                                    </td>
                                    <td class="text-end" t-if="doc.valorado == True and disc3">
                                        <strong>
                                            <span t-if="doc.partner_id.lang == 'ca_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC 3% </font>
                                            </span>
                                            <span t-elif="doc.partner_id.lang == 'en_GB'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DISC 3% </font>
                                            </span>
                                            <span t-else="doc.partner_id.lang == 'es_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC 3% </font>
                                            </span>
                                        </strong>
                                    </td>
                                    <td class="text-end" t-if="doc.valorado == True and disc4">
                                        <strong>
                                            <span t-if="doc.partner_id.lang == 'ca_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC 4% </font>
                                            </span>
                                            <span t-elif="doc.partner_id.lang == 'en_GB'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DISC 4% </font>
                                            </span>
                                            <span t-else="doc.partner_id.lang == 'es_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC 4% </font>
                                            </span>
                                        </strong>
                                    </td>
                                    <td class="text-end" t-if="doc.valorado == True and disc5">
                                        <strong>
                                            <span t-if="doc.partner_id.lang == 'ca_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC 5% </font>
                                            </span>
                                            <span t-elif="doc.partner_id.lang == 'en_GB'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DISC 5% </font>
                                            </span>
                                            <span t-else="doc.partner_id.lang == 'es_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC 5% </font>
                                            </span>
                                        </strong>
                                    </td>


                                </div>
                                <div t-else="">
                                    <td class="text-end" t-if="doc.valorado == True">
                                        <strong>
                                            <span t-if="doc.partner_id.lang == 'ca_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC% </font>
                                            </span>
                                            <span t-elif="doc.partner_id.lang == 'en_GB'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DISC% </font>
                                            </span>
                                            <span t-else="doc.partner_id.lang == 'es_ES'"
                                                style="font-size: 0.75rem;">
                                                <font style="vertical-align: inherit;">DESC% </font>
                                            </span>
                                        </strong>
                                    </td>
                                </div>

                                <td class="text-end" t-if="doc.valorado == True">
                                    <strong />
                                    <strong>
                                        <span t-if="doc.partner_id.lang == 'ca_ES'"
                                            style="font-size: 0.75rem;">
                                            <font style="vertical-align: inherit;">IMPORT </font>
                                        </span>
                                        <span t-elif="doc.partner_id.lang == 'en_GB'"
                                            style="font-size: 0.75rem;">
                                            <font style="vertical-align: inherit;">AMOUNT </font>
                                        </span>
                                        <span t-else="doc.partner_id.lang == 'es_ES'"
                                            style="font-size: 0.75rem;">
                                            <font style="vertical-align: inherit;">IMPORTE </font>
                                        </span>
                                    </strong>
                                </td>
                            </tr>
                        </thead>
                        <tbody style="border-top: 1px solid black;">
                            <t t-foreach="doc.order_line" t-as="line">
                                <t>
                                    <tr>
                                        <td>
                                            <div t-if="line.product_id">
                                                <span t-field="line.name"
                                                    style="font-size: 0.75rem;" />
                                            </div>
                                            <div t-if="len(line.product_id) == 0">
                                                <b>
                                                    <span t-field="line.name"
                                                        style="font-size: 0.75rem;" />
                                                </b>
                                            </div>
                                        </td>

                                        <td class="text-end" t-if="line.product_id">
                                            <span t-field="line.product_uom_qty"
                                                t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"
                                                style="font-size: 0.75rem;">1.00</span>

                                        </td>
                                        <td class="text-end">
                                            <span t-if="line.product_id" t-field="line.price_unit"
                                                t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"
                                                style="font-size: 0.75rem;" />
                                        </td>

                                        <div>
                                            <td t-if="doc.valorado == True and line.product_id">
                                                <span t-if="line.discount" t-field="line.discount"
                                                    t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"
                                                    style="font-size: 0.75rem;" />
                                                <span t-else="line.discount=False" />
                                            </td>

                                        </div>


                                        <td class="text-end"
                                            t-if="doc.valorado == True and line.product_id">
                                            <span t-field="line.price_subtotal"
                                                style="font-size: 0.75rem;" />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </tbody>
                <div class="clearfix" name="so_total_summary">
                    <table border="3" class="table table-sm o_main_table table-borderless mt-4"
                        t-if="doc.valorado == True"
                        style="BORDER-BOTTOM-COLOR: White; BORDER-TOP-COLOR: Blakc; BORDER-RIGHT-COLOR: White">
                        <thead style="display: table-row-group">
                            <tr>
                                <td>
                                    <center>
                                        <strong>
                                            <span t-if="doc.partner_id.lang == 'ca_ES'">
                                                <font style="vertical-align: inherit;">TOTAL BRUT </font>
                                            </span>
                                            <span t-elif="doc.partner_id.lang == 'en_GB'">
                                                <font style="vertical-align: inherit;">GROSS TOTAL </font>
                                            </span>
                                            <span t-else="doc.partner_id.lang == 'es_ES'">
                                                <font style="vertical-align: inherit;">TOTAL BRUTO </font>
                                            </span>
                                        </strong>
                                    </center>
                                </td>
                                <td>
                                    <center>
                                        <strong>
                                            <span t-if="doc.partner_id.lang == 'ca_ES'">
                                                <font style="vertical-align: inherit;">BASE
