                                            </span>
                                            <span t-else="doc.partner_id.lang == 'es_ES'">
                                                <font style="vertical-align: inherit;">TOTAL PEDIDO
                                                    EUR</font>
                                            </span>
                                        </strong>
                                    </center>
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <strong>
                                <t>
                                    <tr>
                                        <td>
                                            <center>
                                                <strong>
                                                    <span t-field="doc.amount_untaxed">
                                                        <font style="vertical-align: inherit;">
                                                            Bimponible</font>
                                                    </span>
                                                </strong>
                                            </center>
                                        </td>
                                        <td>
                                            <center>
                                                <strong>
                                                    <span t-field="doc.amount_untaxed">
                                                        <font style="vertical-align: inherit;">
                                                            Bimponible</font>
                                                    </span>
                                                </strong>
                                            </center>
                                        </td>
                                        <td>
                                            <center>
                                                <strong>
                                                    <table class="table table-sm table-borderless">
                                                        <t t-set="tax_totals"
                                                            t-value="doc.tax_totals" />
                                                        <t
                                                            t-name="account.document_tax_totals_template">
