<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="reporting_sale_order" model="ir.ui.view">
            <field name="name">reporting_sale_order</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//page[@name='other_information']" position="after">
                    <page name="reporting" string="Reporting">
                        <group name="gp_repoting">
                            <field name="valorado" string="Valorado"/>
                        </group>
                        
                    </page>
                </xpath>
                <xpath expr="//button[@name='action_cancel']"
                    position="after" >
                    <button name="action_print_default" string="action_print_default" type="object"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>