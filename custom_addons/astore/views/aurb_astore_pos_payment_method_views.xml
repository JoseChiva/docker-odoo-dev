<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="act_aurb_astore_pos_payment_method" model="ir.actions.act_window">
            <field name="name">act_aurb_astore_pos_payment_method</field>
            <field name="res_model">aurb.astore.pos.payment.method</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="lst_aurb_astore_pos_payment_method" model="ir.ui.view">
            <field name="name">lst_aurb_astore_pos_payment_method</field>
            <field name="model">aurb.astore.pos.payment.method</field>
            <field name="arch" type="xml">
                <list>
                    <field name="pos_id" />
                    <field name="payment_method_id" />
                </list>
            </field>
        </record>
        <record id="frm_aurb_astore_pos_payment_method" model="ir.ui.view">
            <field name="name">frm_aurb_astore_pos_payment_method</field>
            <field name="model">aurb.astore.pos.payment.method</field>
            <field name="arch" type="xml">
                <form >
                    <sheet>
                        <group>
                            <field name="pos_id" invisible="True"/>
                            <field name="payment_method_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>