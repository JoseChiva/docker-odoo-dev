<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="astore_res_users_form" model="ir.ui.view">
            <field name="name">astore_res_users_form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form" />
            <field name="arch" type="xml">
                <!-- find field description and add the field
                     new_field after it -->
                <xpath expr="//page[@name='preferences']"
                    position="after">
                    <page name="astore_res_user" string="astore_res_user">
                        <group>
                            <field name="pos_id"/>
                        </group>
                    </page>
                   
                </xpath>
            </field>
        </record>
        <record id="astore_res_users_simple_form" model="ir.ui.view">
            <field name="name">astore_res_users_simple_form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_simple_form" />
            <field name="arch" type="xml">
                <!-- find field description and add the field
                     new_field after it -->
                <xpath expr="//group[@name='phone_numbers']"
                    position="after">
                    <group name="astore_res_user" string="astore_res_user" >
                            <field name="pos_id" />
                     </group>
                   
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>