<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Tree -->
        <record id="view_gi_type_price_tree" model="ir.ui.view">
            <field name="name">gi.type.price.tree</field>
            <field name="model">gi.type.price</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <!-- Vista Form -->
        <record id="view_gi_type_price_form" model="ir.ui.view">
            <field name="name">gi.type.price.form</field>
            <field name="model">gi.type.price</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción -->
        <record id="action_gi_type_price" model="ir.actions.act_window">
            <field name="name">Tipos de Precio Gamma</field>
            <field name="res_model">gi.type.price</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                                        (0, 0, {'view_mode': 'list', 'view_id': ref('view_gi_type_price_tree')}),
                                        (0, 0, {'view_mode': 'form', 'view_id': ref('view_gi_type_price_form')})]"/>
        </record>

        <!-- Menú para Tipos de Precio Gamma -->
        <menuitem id="menu_gi_type_price"
                name="Tipos de Precio Gamma"
                parent="purchase.menu_purchase_config"
                action="action_gi_type_price"/>
    </data>
</odoo>