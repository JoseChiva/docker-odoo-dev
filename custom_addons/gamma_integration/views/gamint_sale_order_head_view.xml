<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_gamma_header" model="ir.ui.view">
        <field name="name">sale.order.gamma.stock.header</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_get_stock_all_lines"
                        type="object"
                        string="Stock G."
                        class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>