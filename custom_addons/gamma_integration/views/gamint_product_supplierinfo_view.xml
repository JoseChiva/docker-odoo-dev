<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Heredar la vista del formulario de lista de precios de proveedor -->
        <record id="gamint_product_supplierinfo_form_view" model="ir.ui.view">
            <field name="name">product.supplierinfo.form.view.gamint</field>
            <field name="model">product.supplierinfo</field>
            <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
            <field name="arch" type="xml">
                <!-- Insertar los campos dentro del grupo principal -->
                <xpath expr="//sheet/group" position="inside">
                    <group string="Gamma Integration">
                        <field name="gi_code_tarf"/>
                        <field name="gi_name_tarf"/>
                        <field name="gi_type"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="gamint_product_supplierinfo_tree_view" model="ir.ui.view">
            <field name="name">product.supplierinfo.tree.view.gamint</field>
            <field name="model">product.supplierinfo</field>
            <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_tmpl_id']" position="after">
                    <field name="gi_code_tarf"/>
                    <field name="gi_name_tarf"/>
                    <field name="gi_type"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>