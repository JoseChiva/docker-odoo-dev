<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="suco_sale_order_form" model="ir.ui.view">
            <field name="name">suco_sale_order_form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']"
                    position="before">
                    <field name="price_base" readonly="1" force_save="1" optional="show"/>
                    <field name="add_price_unit" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']"
                    position="attributes">
                    <attribute name="domain" add="['|', ('is_company', '=', True), ('type', '!=', 'contact')]" separator=","/>
                </xpath>
                <xpath expr="//button[@name='action_quotation_send']" position="after">
                    <button name="%(suconspa_adapt.report_event_registration_badge_sale_order)d" 
                            string="Imprimir" 
                            type="action" 
                            class="btn-primary"
                            groups="sales_team.group_sale_salesman"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>