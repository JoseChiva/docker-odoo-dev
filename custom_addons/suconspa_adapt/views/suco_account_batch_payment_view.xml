<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_batch_payment_form_inherit_financiada" model="ir.ui.view">
        <field name="name">account.batch.payment.form.inherit.financiada</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <!-- Botón para generar remesa financiada (estado draft) -->
            <xpath expr="//header" position="inside">
                <button name="action_financiada" type="object" string="Financiada" class="btn-primary" invisible="state != 'draft' or not payment_ids"/>
            </xpath>
            
            <!-- Botón para regenerar archivo financiada (estado sent) -->
            <xpath expr="//header" position="inside">
                <button name="action_financiada" type="object" string="Regenerar archivo Financiada" class="btn-secondary" invisible="state != 'sent'"/>
            </xpath>
        </field>
    </record>
</odoo>
