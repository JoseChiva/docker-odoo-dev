<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="suco_purchase_order_form" model="ir.ui.view">
            <field name="name">suco_purchase_order_form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']"
                    position="before">
                    <field name="price_base" readonly="1" force_save="1" optional="show"/>
                    <field name="add_price_unit" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>