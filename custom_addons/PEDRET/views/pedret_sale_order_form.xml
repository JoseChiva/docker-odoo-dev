<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="pedret_sale_order_form" model="ir.ui.view">
            <field name="name">pedret_sale_order_form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_llibreta" string="Pedido llibreta" type="object" invisible="state != 'draft'" />
                    <!-- <button name="action_to_draft" string="Convertir presupuesto" type="object" invisible="state == 'llibreta'" /> -->
                </xpath>
            </field>
        </record>
    </data>
</odoo>