<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="act_aurb_sale_picking" model="ir.actions.act_window">
            <field name="name">Registro de picking</field>
            <field name="res_model">aurb.sale.picking</field>
            <field name="view_mode">tree,form</field>
            <field name="context"></field>
        </record>

        <record id="src_aurb_sale_picking" model="ir.ui.view">
            <field name="name">Registro de picking</field>
            <field name="model">aurb.sale.picking</field>
            <field name="arch" type="xml">
                <search>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="carrier_id" />
                    <field name="state" />
                    <separator />
                    <filter name="iactive" string="Archived" domain="[('active','=',False)]" />
                    <filter name="iprepa" string="Preparando" domain="[('state','=','prepa')]" />
                    <filter name="iprep" string="Preparando" domain="[('state','=','prep')]" />
                    <filter name="ientr" string="Entregado" domain="[('state','=','entr')]" />
                    <filter name="iend" string="Finalizadas" domain="[('state','=','end')]" />
                    <separator />
                    <group expand="0">
                        <filter name="Estado" context="{'group_by':'state'}" />
                        <filter name="carrier_id" context="{'group_by':'carrier_id'}" />
                    </group>
                </search>
            </field>
        </record>
        <record id="lst_aurb_sale_picking" model="ir.ui.view">
            <field name="name">Registro de picking</field>
            <field name="model">aurb.sale.picking</field>
            <field name="arch" type="xml">
                <tree string="Registro de picking">
                    <field name="name" />
                    <field name="carrier_id" />
                    <field name="state" />
                    <field name="date" />
                    <field name="sale_order_line_ids" widget="many2many_tags" />
                </tree>
            </field>
        </record>
        <record id="frm_aurb_sale_picking" model="ir.ui.view">
            <field name="name">Registro de picking</field>
            <field name="model">aurb.sale.picking</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="%(report_sale_picking_report_landscape_action)d" string="Imprimir" type="action" icon="fa-print"/>
                        <field name="state" widget="statusbar" options="{'clickable': '1'}" />
                        <button name="action_get_not_delivery_lines" type="object" string="Cargar línea no entregas"
                    confirm="¿Se procederá a cargar las líneas no entregas de día anteriores para el transportista seleccionado, desea continuar?" />
                    </header>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="general_info">
                        <field name="company_id" invisible="1"/>
                        <field name="carrier_id" />
                        <field name="date" />
                    </group>
                    <notebook>
                        <page name="stock_move" string="Líneas a entregar">
                            <field name="sale_order_line_ids" no_label="1">
                                <tree editable="bottom" create="0" delete="0">
                                    <field name="company_id" column_invisible="1" />
                                    <field name="pick_order" widget="handle"/>
                                    <field name="pick_travel_num" string="Viatge"/>
                                    <field name="pick_print"/>
                                    <field name="pick_delivery"/>
                                    <field name="order_id" readonly="1" />
                                    <field name="order_partner_id" readonly="1" />
                                    <field name="res_partner_contact" readonly="1" />
                                    <field name="pick_date_ship" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <!-- <field name="name" readonly="1"/> -->
                                    <field name="product_uom_qty" readonly="1"/>
                                    <!-- <field name="quantity"/> -->
                                    <field name="pick_comment"/>
                                    <field name="pick_pro_order"/>
                                    
                                </tree>
                            </field>
                            <group>
                                <field name="sale_order_lines_count"/>
                            </group>
                            
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <menuitem id="menu_aurb_sale_picking_action"
            name="Picking"
            action="act_aurb_sale_picking"
            parent="stock.menu_stock_transfers"
            sequence="150" />
    </data>


</odoo>