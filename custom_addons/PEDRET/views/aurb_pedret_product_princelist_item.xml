<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="aurb_pedret_product_princelist_item_form" model="ir.ui.view">
            <field name="name">aurb_pedret_product_princelist_item_form</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='fixed_price']"
                    position="after">
                    <field name="price_with_var1" string="+Trailer" invisible="compute_price != 'fixed'" />
                    <field name="price_with_var2" string="+Camion" invisible="compute_price != 'fixed'" />
                    <field name="price_with_var3" string="+Reparto" invisible="compute_price != 'fixed'" />
                    <field name="num_contract" string="Num.Contra." invisible="compute_price != 'fixed'" />
                </xpath>
            </field>
        </record>
        <record id="aurb_pedret_product_pricelist_view" model="ir.ui.view">
            <field name="name">aurb_pedret_product_pricelist_view</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view" />
            <field name="arch" type="xml">

                <xpath expr="//field[@name='company_id']"
                    position="after">
                    <field name="res_partner_id"/>
                    <button name="button_create_sale_order" type="object" string="Crear presupuesto" />
                </xpath>
                <xpath expr="//page[@name='pricelist_config']"
                    position="after">
                    <page name="sale_order" string="Ventas">
                        <field name="sale_order_ids" readonly="1"/>
                    </page>
                </xpath>

                <xpath expr="//field[@name='item_ids']//field[@name='fixed_price']"
                    position="after">
                    <field name="compute_price" invisible="1"/>
                    <field name="price_with_var1" string="+Trailer" invisible="compute_price != 'fixed'" />
                    <field name="price_with_var2" string="+Camion" invisible="compute_price != 'fixed'"/>
                    <field name="price_with_var3" string="+Reparto" invisible="compute_price != 'fixed'" />
                    <field name="num_contract" string="Num.Contra." invisible="compute_price != 'fixed'" />
                </xpath>
                <xpath expr="//field[@name='item_ids']//field[@name='price']"
                    position="after">
                    <field name="compute_price" invisible="1"/>
                    <field name="price_with_var1" string="+Trailer" invisible="compute_price != 'fixed'" />
                    <field name="price_with_var2" string="+Camion" invisible="compute_price != 'fixed'"/>
                    <field name="price_with_var3" string="+Reparto" invisible="compute_price != 'fixed'" />
                    <field name="num_contract" string="Num.Contra." invisible="compute_price != 'fixed'" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>