                                    <t t-set="tax_label" t-value="group.get('group_name', group.get('tax_group_name', ''))"/>
                                    <t t-if="group.get('tax_group_rate')">
                                        <span t-out="tax_label"/> <span t-out="str(round(group.get('tax_group_rate', 0), 2)).replace('.', ',') + '%'"/>
