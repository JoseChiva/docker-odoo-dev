<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_event_registration_badge_account_move" model="ir.actions.report">
        <field name="name">Factura de venta PEDRET</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">PEDRET.report_pedr_account_move_format_prin</field> <!-- Es el id del template con el prefijo del nombre del modulo-->
        <field name="report_file">PEDRET.report_pedr_account_move_format_prin</field>
        <field name="print_report_name">('Factura - %s' % (object.name or '')).replace('/','')</field>
        <field name="binding_model_id" ref="account.model_account_move"/> <!-- Es el id del modelo con el prefijo 'model_'-->
    </record>
</odoo>