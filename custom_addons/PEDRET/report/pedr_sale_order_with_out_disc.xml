<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_event_registration_badge_sale_order" model="ir.actions.report">
        <field name="name">Pedido/Presupuesto de venta PEDRET</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">PEDRET.report_pedr_sales_order_format_prin</field> <!-- Es el id del template con el prefijo del nombre del modulo-->
        <field name="report_file">PEDRET.report_pedr_sales_order_format_prin</field>
        <field name="print_report_name">'Pedido - %s' % (object.name).replace('/','')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/> <!-- Es el id del modelo con el prefijo 'model_'-->
    </record>
</odoo>