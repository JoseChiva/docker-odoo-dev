<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="auren_cst_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.auren.cst</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="99" />
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="cost_standard_extended"
                        id="cost_standard_extended" string="Extensión Coste standard"
                        name="cost_standard_extended"
                    >
                        <div
                            class="app_settings_block" data-string="Extensión Coste standard"
                            string="Extensión Coste standard"
                            data-key="cost_standard_extended"
                        >
                            <block title="Inventario" id="end_inv_settings">
                                <setting string="Cost standard">
                                    <field name="group_cost_standard" />
                                </setting>

                            </block>
                        </div>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="auren_cst_config_settings_action" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_id" ref="auren_cst_res_config_settings_view_form"/>
            <field name="view_mode">form</field>         
            <field name="context">{'module' : 'cost_standard_extended', 'bin_size': False}</field>
        </record>
</odoo>