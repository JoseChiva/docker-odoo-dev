<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="auren_cst_product_template_uom_" model="ir.ui.view">
            <field name="name">auren_cst_product_template_uom_</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view" />
            <field name="arch" type="xml">
                <!-- find field description and add the field
                     new_field after it -->
                <xpath expr="//page[@name='general_information']" position="after">
                    <field name="auren_property_cost_method" invisible="True"/>
                    <page name="cost_standard" string="Coste estandard" invisible="auren_property_cost_method!='standard'" groups="cost_standard_extended.group_cost_standard">
                        <field name="cost_standards_ids" >
                            <list string="Cost Standard" editable="bottom" >
                                <field name="product_id" readonly="True" column_invisible="1"/>
                                <field name="cost_standard_id" string="Nombre coste" />
                                <field name="cost" sum="Total Cost"/>
                            </list>
                        </field>
                        <!-- <group name="total_standard_price">
                            <field name="standard_price"  readonly="True"/>
                        </group> -->
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>