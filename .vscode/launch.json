    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 8888
            },
            "pathMappings": [
                {
                    "localRoot": "C:\\Docker\\odoo_18_project\\recursos\\odoo\\addons",
                    "remoteRoot": "/var/lib/odoo/odoo/addons"
                },
                {
                    "localRoot": "C:\\Docker\\odoo_18_project\\recursos\\enterprise",
                    "remoteRoot": "/var/lib/odoo/enterprise"
                },
                {
                    "localRoot": "${workspaceFolder}/custom_addons",
                    "remoteRoot": "/mnt/extra-addons"
                }
            ]
        }
    ],
    "logOutput": "dap",
    "showLog": true
}